# Copy to .env.local for local development. Never put secrets in NEXT_PUBLIC_* variables.

# Deployment environment: development | staging | production.
# Inlined at build time. "production" hides dev-only routes such as /dev/tokens.
NEXT_PUBLIC_APP_ENV=development

# Server only. Base URL of fleetflow-api, used by the BFF from Phase 1.
FLEETFLOW_API_URL=http://localhost:8000
