{
  "name": "fleetflow-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "api:schema:sync": "git -C ../fleetflow-api fetch --quiet origin main && git -C ../fleetflow-api show origin/main:openapi/schema.yaml > openapi/fleetflow-api.yaml",
    "api:types": "npx --yes -p openapi-typescript@7.13.0 -p typescript@5.9.3 openapi-typescript openapi/fleetflow-api.yaml -o src/generated/api.d.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.8",
    "@tanstack/react-query": "5.108.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.78.0",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "server-only": "0.0.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "prettier": "3.10.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
